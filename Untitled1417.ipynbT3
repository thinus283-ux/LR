      "source": [
        "\n",
        "# =====================================================================\n",
        "# LR-DC COSMOLOGY TEST — FRESH GOOGLE COLAB SESSION\n",
        "#\n",
        "# 1. Standard CAMB Lambda-CDM control\n",
        "# 2. AxiECAMB scalar-field case: 1.0e-23 eV\n",
        "# 3. AxiECAMB scalar-field case: 2.4e-22 eV\n",
        "# 4. AxiECAMB scalar-field case: 1.0e-21 eV\n",
        "#\n",
        "# Includes:\n",
        "#   - Fortran long-line compiler fix\n",
        "#   - Sequential compilation / explicit module dependency\n",
        "#   - Standard CAMB CMB and matter-power control outputs\n",
        "#   - AxiECAMB outputs and solver logs\n",
        "#   - Run report and downloadable ZIP\n",
        "#\n",
        "# Trial masses are not fitted or selected LR-DC parameters.\n",
        "# This does not by itself close halo formation or mode occupation.\n",
        "# =====================================================================\n",
        "\n",
        "import os\n",
        "import re\n",
        "import sys\n",
        "import time\n",
        "import shutil\n",
        "import zipfile\n",
        "import subprocess\n",
        "import traceback\n",
        "from pathlib import Path\n",
        "\n",
        "# ------------------------- CONFIGURATION -------------------------\n",
        "\n",
        "ROOT = Path(\"/content/LRDC_AxiECAMB_Colab\")\n",
        "REPO = ROOT / \"AxiECAMB\"\n",
        "RESULTS = ROOT / \"results\"\n",
        "ZIP_PATH = Path(\"/content/LRDC_AxiECAMB_results.zip\")\n",
        "\n",
        "# Use the source revision that compiled and completed the three\n",
        "# scalar runs in the previous Colab session.\n",
        "SOURCE_COMMIT = \"b7ca9ba80aca178da5003d864b8e20cb5905555b\"\n",
        "\n",
        "H0 = 67.36\n",
        "OMBH2 = 0.0224\n",
        "OMDMH2 = 0.1200\n",
        "AS = 2.196e-9\n",
        "NS = 0.9655\n",
        "TAU = 0.05\n",
        "MNU_EV = 0.06\n",
        "\n",
        "REDSHIFTS = [249, 49, 0]\n",
        "\n",
        "SCALAR_MODELS = [\n",
        "    {\"tag\": \"LRDC_scalar_m1e-23_eV\", \"mass_eV\": 1.0e-23},\n",
        "    {\"tag\": \"LRDC_scalar_m2p4e-22_eV\", \"mass_eV\": 2.4e-22},\n",
        "    {\"tag\": \"LRDC_scalar_m1e-21_eV\", \"mass_eV\": 1.0e-21},\n",
        "]\n",
        "\n",
        "STATUS = {\n",
        "    \"camb_control\": \"NOT RUN\",\n",
        "    \"axi_build\": \"NOT RUN\",\n",
        "    \"axi_models\": {},\n",
        "    \"source_commit\": SOURCE_COMMIT,\n",
        "}\n",
        "\n",
        "# Keep numerical libraries from over-subscribing Colab's CPU.\n",
        "os.environ[\"OMP_NUM_THREADS\"] = \"2\"\n",
        "os.environ[\"OPENBLAS_NUM_THREADS\"] = \"1\"\n",
        "os.environ[\"MKL_NUM_THREADS\"] = \"1\"\n",
        "\n",
        "\n",
        "# ------------------------- HELPER FUNCTIONS -------------------------\n",
        "\n",
        "def run_command(command, cwd=None, timeout=None, log_path=None):\n",
        "    \"\"\"Run a command and retain output for diagnostics.\"\"\"\n",
        "    print(\"\\n$\", \" \".join(map(str, command)), flush=True)\n",
        "\n",
        "    if log_path:\n",
        "        log_path = Path(log_path)\n",
        "        log_path.parent.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "        with log_path.open(\"w\") as log:\n",
        "            proc = subprocess.run(\n",
        "                command,\n",
        "                cwd=cwd,\n",
        "                stdout=log,\n",
        "                stderr=subprocess.STDOUT,\n",
        "                text=True,\n",
        "                timeout=timeout,\n",
        "            )\n",
        "\n",
        "        output = log_path.read_text(errors=\"replace\")\n",
        "    else:\n",
        "        proc = subprocess.run(\n",
        "            command,\n",
        "            cwd=cwd,\n",
        "            stdout=subprocess.PIPE,\n",
        "            stderr=subprocess.STDOUT,\n",
        "            text=True,\n",
        "            timeout=timeout,\n",
        "        )\n",
        "        output = proc.stdout\n",
        "\n",
        "    if output:\n",
        "        print(output[-6000:], flush=True)\n",
        "\n",
        "    if proc.returncode != 0:\n",
        "        raise RuntimeError(\n",
        "            f\"Exit code {proc.returncode}: \"\n",
        "            + \" \".join(map(str, command))\n",
        "        )\n",
        "\n",
        "    return output\n",
        "\n",
        "\n",
        "def set_ini_value(text, key, value):\n",
        "    \"\"\"Replace an INI setting or append it if missing.\"\"\"\n",
        "    pattern = re.compile(\n",
        "        r\"(?m)^\\s*\" + re.escape(key) + r\"\\s*=.*$\"\n",
        "    )\n",
        "    replacement = f\"{key} = {value}\"\n",
        "\n",
        "    if pattern.search(text):\n",
        "        return pattern.sub(\n",
        "            lambda match: replacement,\n",
        "            text,\n",
        "            count=1,\n",
        "        )\n",
        "\n",
        "    return text.rstrip() + \"\\n\" + replacement + \"\\n\"\n",
        "\n",
        "\n",
        "def save_text(path, text):\n",
        "    path = Path(path)\n",
        "    path.parent.mkdir(parents=True, exist_ok=True)\n",
        "    path.write_text(str(text))\n",
        "\n",
        "\n",
        "# ------------------------- STEP 1: CLEAN WORKSPACE -------------------------\n",
        "\n",
        "print(\"=\" * 72)\n",
        "print(\"STEP 1 — Preparing a clean workspace\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "if ROOT.exists():\n",
        "    shutil.rmtree(ROOT)\n",
        "\n",
        "if ZIP_PATH.exists():\n",
        "    ZIP_PATH.unlink()\n",
        "\n",
        "RESULTS.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "\n",
        "# ------------------------- STEP 2: INSTALL DEPENDENCIES -------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 72)\n",
        "print(\"STEP 2 — Installing compilers and Python CAMB\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "run_command([\n",
        "    \"bash\", \"-lc\",\n",
        "    \"apt-get update -qq && \"\n",
        "    \"apt-get install -y -qq git gfortran make \"\n",
        "    \"liblapack-dev libblas-dev\"\n",
        "])\n",
        "\n",
        "# Install the standard Python CAMB package for the independent\n",
        "# Lambda-CDM reference run.\n",
        "run_command([\n",
        "    sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"camb\"\n",
        "])\n",
        "\n",
        "\n",
        "# ------------------------- STEP 3: STANDARD CAMB CONTROL -------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 72)\n",
        "print(\"STEP 3 — Running standard CAMB Lambda-CDM control\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "control_dir = RESULTS / \"CAMB_LCDM_Control\"\n",
        "control_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "try:\n",
        "    import numpy as np\n",
        "    import camb\n",
        "    from camb import model\n",
        "\n",
        "    print(\"Python CAMB version:\", camb.__version__)\n",
        "\n",
        "    pars = camb.CAMBparams()\n",
        "\n",
        "    pars.set_cosmology(\n",
        "        H0=H0,\n",
        "        ombh2=OMBH2,\n",
        "        omch2=OMDMH2,\n",
        "        mnu=MNU_EV,\n",
        "        tau=TAU,\n",
        "        nnu=3.044,\n",
        "    )\n",
        "\n",
        "    pars.InitPower.set_params(\n",
        "        As=AS,\n",
        "        ns=NS,\n",
        "        pivot_scalar=0.05,\n",
        "    )\n",
        "\n",
        "    # Linear matter power only; no Halofit correction.\n",
        "    pars.NonLinear = model.NonLinear_none\n",
        "\n",
        "    pars.set_for_lmax(\n",
        "        2700,\n",
        "        lens_potential_accuracy=1,\n",
        "    )\n",
        "\n",
        "    pars.set_matter_power(\n",
        "        redshifts=REDSHIFTS,\n",
        "        kmax=20.0,\n",
        "        k_per_logint=8,\n",
        "    )\n",
        "\n",
        "    save_text(\n",
        "        control_dir / \"parameters.txt\",\n",
        "        \"\\n\".join([\n",
        "            f\"H0 = {H0}\",\n",
        "            f\"ombh2 = {OMBH2}\",\n",
        "            f\"omch2 = {OMDMH2}\",\n",
        "            f\"mnu_eV = {MNU_EV}\",\n",
        "            f\"tau = {TAU}\",\n",
        "            f\"As = {AS}\",\n",
        "            f\"ns = {NS}\",\n",
        "            f\"requested_matter_power_redshifts = {REDSHIFTS}\",\n",
        "            \"NonLinear = NonLinear_none\",\n",
        "            \"Reference = standard Python CAMB; not AxiECAMB\",\n",
        "        ]) + \"\\n\",\n",
        "    )\n",
        "\n",
        "    t0 = time.time()\n",
        "    camb_results = camb.get_results(pars)\n",
        "\n",
        "    # CAMB returns D_l = l(l+1)C_l/(2*pi) when raw_cl=False.\n",
        "    cmb_spectra = camb_results.get_cmb_power_spectra(\n",
        "        lmax=2700,\n",
        "        CMB_unit=\"muK\",\n",
        "        raw_cl=False,\n",
        "    )\n",
        "\n",
        "    for key in [\n",
        "        \"total\",\n",
        "        \"unlensed_scalar\",\n",
        "        \"lensed_scalar\",\n",
        "        \"lens_potential\",\n",
        "    ]:\n",
        "        if key in cmb_spectra:\n",
        "            arr = np.asarray(cmb_spectra[key])\n",
        "\n",
        "            if arr.ndim == 2 and arr.shape[1] > 0:\n",
        "                ell = np.arange(arr.shape[0])\n",
        "                table = np.column_stack([ell, arr])\n",
        "\n",
        "                save_path = control_dir / f\"CMB_{key}.dat\"\n",
        "\n",
        "                np.savetxt(\n",
        "                    save_path,\n",
        "                    table,\n",
        "                    fmt=\"%.12e\",\n",
        "                    header=(\n",
        "                        \"ell followed by columns returned by CAMB. \"\n",
        "                        \"CMB spectra use muK^2 and D_ell=l(l+1)C_ell/(2pi) \"\n",
        "                        \"unless otherwise documented by CAMB.\"\n",
        "                    ),\n",
        "                )\n",
        "\n",
        "    kh, redshift_out, matter_pk = (\n",
        "        camb_results.get_matter_power_spectrum(\n",
        "            minkh=1.0e-4,\n",
        "            maxkh=10.0,\n",
        "            npoints=512,\n",
        "            have_power_spectra=True,\n",
        "        )\n",
        "    )\n",
        "\n",
        "    matter_pk = np.asarray(matter_pk)\n",
        "    redshift_out = np.asarray(redshift_out)\n",
        "\n",
        "    if matter_pk.shape[0] != len(redshift_out):\n",
        "        raise RuntimeError(\n",
        "            \"CAMB matter-power array shape does not match returned \"\n",
        "            \"redshift array.\"\n",
        "        )\n",
        "\n",
        "    matter_columns = [kh]\n",
        "    header_columns = [\"k_h_Mpc_inverse\"]\n",
        "\n",
        "    for i, z in enumerate(redshift_out):\n",
        "        matter_columns.append(matter_pk[i])\n",
        "        header_columns.append(f\"P_m_z_{z:g}_Mpc_over_h_cubed\")\n",
        "\n",
        "    matter_table = np.column_stack(matter_columns)\n",
        "\n",
        "    np.savetxt(\n",
        "        control_dir / \"matter_power_linear_all_redshifts.dat\",\n",
        "        matter_table,\n",
        "        fmt=\"%.12e\",\n",
        "        header=\" \".join(header_columns),\n",
        "    )\n",
        "\n",
        "    save_text(\n",
        "        control_dir / \"matter_power_redshifts.txt\",\n",
        "        \"\\n\".join(str(float(z)) for z in redshift_out) + \"\\n\",\n",
        "    )\n",
        "\n",
        "    # Record sigma8 values and the order returned by CAMB.\n",
        "    sigma8 = np.asarray(camb_results.get_sigma8())\n",
        "    np.savetxt(\n",
        "        control_dir / \"sigma8_returned_order.dat\",\n",
        "        sigma8,\n",
        "        fmt=\"%.12e\",\n",
        "        header=(\n",
        "            \"sigma8 values in the order returned by this CAMB version; \"\n",
        "            \"see CAMB API documentation for redshift ordering.\"\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    elapsed = (time.time() - t0) / 60.0\n",
        "\n",
        "    save_text(\n",
        "        control_dir / \"control_status.txt\",\n",
        "        f\"STATUS: SUCCESS\\n\"\n",
        "        f\"CAMB version: {camb.__version__}\\n\"\n",
        "        f\"Runtime minutes: {elapsed:.3f}\\n\"\n",
        "        f\"Returned matter-power redshifts: {redshift_out.tolist()}\\n\",\n",
        "    )\n",
        "\n",
        "    STATUS[\"camb_control\"] = \"SUCCESS\"\n",
        "\n",
        "    print(f\"Standard CAMB control completed in {elapsed:.2f} minutes.\")\n",
        "    print(\"Matter-power redshifts:\", redshift_out.tolist())\n",
        "    print(\"Control outputs:\", control_dir)\n",
        "\n",
        "except Exception as exc:\n",
        "    STATUS[\"camb_control\"] = f\"FAILED: {type(exc).__name__}: {exc}\"\n",
        "\n",
        "    save_text(\n",
        "        control_dir / \"control_error.txt\",\n",
        "        traceback.format_exc(),\n",
        "    )\n",
        "\n",
        "    print(\"\\nSTANDARD CAMB CONTROL FAILED:\")\n",
        "    print(traceback.format_exc())\n",
        "\n",
        "\n",
        "# ------------------------- STEP 4: GET AXIECamb SOURCE -------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 72)\n",
        "print(\"STEP 4 — Downloading the previously tested AxiECAMB revision\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "build_ok = False\n",
        "\n",
        "try:\n",
        "    run_command([\n",
        "        \"git\", \"clone\",\n",
        "        \"https://github.com/Ra-yne/AxiECAMB.git\",\n",
        "        str(REPO),\n",
        "    ])\n",
        "\n",
        "    run_command([\n",
        "        \"git\", \"checkout\", \"--detach\", SOURCE_COMMIT,\n",
        "    ], cwd=REPO)\n",
        "\n",
        "    actual_commit = subprocess.run(\n",
        "        [\"git\", \"rev-parse\", \"HEAD\"],\n",
        "        cwd=REPO,\n",
        "        check=True,\n",
        "        capture_output=True,\n",
        "        text=True,\n",
        "    ).stdout.strip()\n",
        "\n",
        "    if actual_commit != SOURCE_COMMIT:\n",
        "        raise RuntimeError(\n",
        "            f\"Requested commit {SOURCE_COMMIT}, but checkout is {actual_commit}\"\n",
        "        )\n",
        "\n",
        "    save_text(\n",
        "        ROOT / \"source_commit.txt\",\n",
        "        f\"AxiECAMB source commit:\\n{actual_commit}\\n\",\n",
        "    )\n",
        "\n",
        "    print(\"AxiECAMB source commit:\", actual_commit)\n",
        "\n",
        "except Exception as exc:\n",
        "    STATUS[\"axi_build\"] = f\"SOURCE FAILED: {type(exc).__name__}: {exc}\"\n",
        "\n",
        "    save_text(ROOT / \"source_error.txt\", traceback.format_exc())\n",
        "\n",
        "    print(\"\\nAxiECAMB source setup failed:\")\n",
        "    print(traceback.format_exc())\n",
        "\n",
        "\n",
        "# ------------------------- STEP 5: PATCH BUILD -------------------------\n",
        "\n",
        "if REPO.exists():\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 72)\n",
        "    print(\"STEP 5 — Applying Fortran build fixes\")\n",
        "    print(\"=\" * 72)\n",
        "\n",
        "    try:\n",
        "        makefile = REPO / \"Makefile\"\n",
        "\n",
        "        if not makefile.exists():\n",
        "            raise FileNotFoundError(\"Makefile was not found.\")\n",
        "\n",
        "        make_text = makefile.read_text()\n",
        "\n",
        "        fflags_pattern = re.compile(r\"(?m)^FFLAGS\\s*=\\s*(.*)$\")\n",
        "        fflags_match = fflags_pattern.search(make_text)\n",
        "\n",
        "        if not fflags_match:\n",
        "            raise RuntimeError(\n",
        "                \"Could not locate the active FFLAGS line in Makefile.\"\n",
        "            )\n",
        "\n",
        "        flags = fflags_match.group(1).strip()\n",
        "\n",
        "        if \"-ffree-line-length-none\" not in flags:\n",
        "            flags += \" -ffree-line-length-none\"\n",
        "\n",
        "        make_text = fflags_pattern.sub(\n",
        "            \"FFLAGS = \" + flags,\n",
        "            make_text,\n",
        "            count=1,\n",
        "        )\n",
        "\n",
        "        makefile.write_text(make_text)\n",
        "\n",
        "        if not (REPO / \"Makefile_main\").exists():\n",
        "            raise FileNotFoundError(\"Makefile_main was not found.\")\n",
        "\n",
        "        main_makefile = REPO / \"Makefile_main\"\n",
        "        main_text = main_makefile.read_text()\n",
        "\n",
        "        # Explicitly enforce module build order. Build sequentially as\n",
        "        # well, rather than relying on parallel compilation to order .mod\n",
        "        # files correctly.\n",
        "        dependency = \"$(NONLINEAR).o: $(EQUATIONS).o modules.o\"\n",
        "\n",
        "        if dependency not in main_text:\n",
        "            main_text += (\n",
        "                \"\\n\\n# Colab build-order fix for the Fortran module dependency\\n\"\n",
        "                + dependency\n",
        "                + \"\\n\"\n",
        "            )\n",
        "\n",
        "        main_makefile.write_text(main_text)\n",
        "\n",
        "        save_text(\n",
        "            ROOT / \"compiler_flags.txt\",\n",
        "            \"FFLAGS = \" + flags + \"\\n\"\n",
        "            + \"Build mode: make -j1\\n\"\n",
        "            + \"Module dependency: \" + dependency + \"\\n\",\n",
        "        )\n",
        "\n",
        "        print(\"FFLAGS:\", flags)\n",
        "        print(\"Dependency:\", dependency)\n",
        "\n",
        "        clean = subprocess.run(\n",
        "            [\"make\", \"clean\"],\n",
        "            cwd=REPO,\n",
        "            stdout=subprocess.PIPE,\n",
        "            stderr=subprocess.STDOUT,\n",
        "            text=True,\n",
        "        )\n",
        "\n",
        "        print(clean.stdout[-3000:])\n",
        "\n",
        "        if clean.returncode != 0:\n",
        "            raise RuntimeError(\"make clean failed.\")\n",
        "\n",
        "        build_log = ROOT / \"build.log\"\n",
        "\n",
        "        print(\"Compiling sequentially. Please wait...\", flush=True)\n",
        "\n",
        "        with build_log.open(\"w\") as log:\n",
        "            proc = subprocess.run(\n",
        "                [\"make\", \"-j1\"],\n",
        "                cwd=REPO,\n",
        "                stdout=log,\n",
        "                stderr=subprocess.STDOUT,\n",
        "                text=True,\n",
        "                timeout=1200,\n",
        "            )\n",
        "\n",
        "        if proc.returncode != 0:\n",
        "            print(\"\\nBUILD FAILED — final build-log section:\")\n",
        "            print(build_log.read_text(errors=\"replace\")[-16000:])\n",
        "            raise RuntimeError(\"AxiECAMB make -j1 failed.\")\n",
        "\n",
        "        if not (REPO / \"camb\").exists():\n",
        "            raise FileNotFoundError(\n",
        "                \"Build ended without creating the camb executable.\"\n",
        "            )\n",
        "\n",
        "        build_ok = True\n",
        "        STATUS[\"axi_build\"] = \"SUCCESS\"\n",
        "\n",
        "        print(\"\\nAXIECamb BUILD SUCCESSFUL.\")\n",
        "\n",
        "    except Exception as exc:\n",
        "        STATUS[\"axi_build\"] = f\"FAILED: {type(exc).__name__}: {exc}\"\n",
        "\n",
        "        print(\"\\nAXIECamb BUILD FAILED:\")\n",
        "        print(traceback.format_exc())\n",
        "\n",
        "        if (ROOT / \"build.log\").exists():\n",
        "            print(\n",
        "                (ROOT / \"build.log\").read_text(errors=\"replace\")[-16000:]\n",
        "            )\n",
        "\n",
        "\n",
        "# ------------------------- STEP 6: RUN AXIECamb SCALAR MODELS -------------------------\n",
        "\n",
        "if build_ok:\n",
        "\n",
        "    print(\"\\n\" + \"=\" * 72)\n",
        "    print(\"STEP 6 — Running three AxiECAMB scalar-field cases\")\n",
        "    print(\"=\" * 72)\n",
        "\n",
        "    base_file = REPO / \"params.ini\"\n",
        "\n",
        "    if not base_file.exists():\n",
        "        raise FileNotFoundError(\"AxiECAMB params.ini was not found.\")\n",
        "\n",
        "    base_params = base_file.read_text()\n",
        "\n",
        "    for model_case in SCALAR_MODELS:\n",
        "\n",
        "        tag = model_case[\"tag\"]\n",
        "        mass = model_case[\"mass_eV\"]\n",
        "\n",
        "        print(\"\\n\" + \"#\" * 72)\n",
        "        print(\"MODEL:\", tag)\n",
        "        print(\"Scalar mass [eV]:\", f\"{mass:.8e}\")\n",
        "        print(\"#\" * 72, flush=True)\n",
        "\n",
        "        run_dir = RESULTS / tag\n",
        "        run_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "        params = base_params\n",
        "\n",
        "        settings = {\n",
        "            \"output_root\": tag,\n",
        "\n",
        "            \"get_scalar_cls\": \"T\",\n",
        "            \"get_vector_cls\": \"F\",\n",
        "            \"get_tensor_cls\": \"F\",\n",
        "            \"get_transfer\": \"T\",\n",
        "\n",
        "            \"do_lensing\": \"T\",\n",
        "            \"do_nonlinear\": \"0\",\n",
        "\n",
        "            \"use_physical\": \"T\",\n",
        "            \"hubble\": f\"{H0}\",\n",
        "            \"ombh2\": f\"{OMBH2}\",\n",
        "\n",
        "            # The AxiECAMB documented parametrization uses omdah2 as\n",
        "            # total DM abundance and axfrac as the ULA fraction.\n",
        "            \"use_axfrac\": \"T\",\n",
        "            \"omdah2\": f\"{OMDMH2}\",\n",
        "            \"axfrac\": \"1.0\",\n",
        "            \"m_ax\": f\"{mass:.8e}\",\n",
        "\n",
        "            # With axfrac=1, the CDM remainder is zero.\n",
        "            \"omch2\": \"0.0\",\n",
        "\n",
        "            \"axion_isocurvature\": \"F\",\n",
        "\n",
        "            \"transfer_num_redshifts\": \"3\",\n",
        "            \"transfer_redshift(1)\": \"249\",\n",
        "            \"transfer_redshift(2)\": \"49\",\n",
        "            \"transfer_redshift(3)\": \"0\",\n",
        "\n",
        "            \"transfer_filename(1)\": \"transfer_z249.dat\",\n",
        "            \"transfer_filename(2)\": \"transfer_z49.dat\",\n",
        "            \"transfer_filename(3)\": \"transfer_z0.dat\",\n",
        "\n",
        "            \"transfer_matterpower(1)\": \"matterpower_z249.dat\",\n",
        "            \"transfer_matterpower(2)\": \"matterpower_z49.dat\",\n",
        "            \"transfer_matterpower(3)\": \"matterpower_z0.dat\",\n",
        "\n",
        "            \"transfer_kmax\": \"20\",\n",
        "            \"transfer_k_per_logint\": \"8\",\n",
        "            \"transfer_high_precision\": \"T\",\n",
        "            \"transfer_interp_matterpower\": \"T\",\n",
        "\n",
        "            \"accuracy_boost\": \"1\",\n",
        "            \"l_accuracy_boost\": \"1\",\n",
        "            \"movH_switch\": \"10\",\n",
        "            \"feedback_level\": \"1\",\n",
        "        }\n",
        "\n",
        "        for key, value in settings.items():\n",
        "            params = set_ini_value(params, key, value)\n",
        "\n",
        "        params_file = run_dir / \"params.ini\"\n",
        "        params_file.write_text(params)\n",
        "\n",
        "        solver_log = run_dir / \"solver.log\"\n",
        "\n",
        "        # Remove stale files only for this model's output prefix.\n",
        "        for old in REPO.glob(tag + \"_*\"):\n",
        "            if old.is_file():\n",
        "                old.unlink()\n",
        "\n",
        "        t0 = time.time()\n",
        "\n",
        "        try:\n",
        "            with solver_log.open(\"w\") as log:\n",
        "                proc = subprocess.run(\n",
        "                    [str(REPO / \"camb\"), str(params_file)],\n",
        "                    cwd=REPO,\n",
        "                    stdout=log,\n",
        "                    stderr=subprocess.STDOUT,\n",
        "                    text=True,\n",
        "                    timeout=1200,\n",
        "                )\n",
        "\n",
        "            log_text = solver_log.read_text(errors=\"replace\")\n",
        "\n",
        "            if proc.returncode != 0:\n",
        "                raise RuntimeError(\n",
        "                    f\"Solver exit code {proc.returncode}\"\n",
        "                )\n",
        "\n",
        "            files_found = [\n",
        "                p for p in REPO.glob(tag + \"_*\")\n",
        "                if p.is_file()\n",
        "            ]\n",
        "\n",
        "            if not files_found:\n",
        "                raise RuntimeError(\n",
        "                    \"Solver returned without creating output files \"\n",
        "                    \"with the expected model prefix.\"\n",
        "                )\n",
        "\n",
        "            # Capture all model outputs.\n",
        "            for src in files_found:\n",
        "                shutil.copy2(src, run_dir / src.name)\n",
        "\n",
        "            expected_suffixes = [\n",
        "                \"_lensedCls.dat\",\n",
        "                \"_matterpower_z0.dat\",\n",
        "                \"_transfer_z0.dat\",\n",
        "                \"_transfer_z49.dat\",\n",
        "                \"_transfer_z249.dat\",\n",
        "            ]\n",
        "\n",
        "            missing = [\n",
        "                suffix for suffix in expected_suffixes\n",
        "                if not (run_dir / (tag + suffix)).exists()\n",
        "            ]\n",
        "\n",
        "            elapsed = (time.time() - t0) / 60.0\n",
        "\n",
        "            if missing:\n",
        "                status = \"PARTIAL OUTPUT — missing: \" + \", \".join(missing)\n",
        "            else:\n",
        "                status = \"OUTPUT FILES DETECTED; scientific validation pending\"\n",
        "\n",
        "            STATUS[\"axi_models\"][tag] = status\n",
        "\n",
        "            save_text(\n",
        "                run_dir / \"run_status.txt\",\n",
        "                f\"{status}\\n\"\n",
        "                f\"Runtime minutes: {elapsed:.3f}\\n\"\n",
        "                f\"Outputs collected: {len(files_found)}\\n\",\n",
        "            )\n",
        "\n",
        "            inventory = [\n",
        "                f\"{f.name}\\t{f.stat().st_size} bytes\"\n",
        "                for f in sorted(run_dir.iterdir())\n",
        "                if f.is_file()\n",
        "            ]\n",
        "\n",
        "            save_text(\n",
        "                run_dir / \"output_inventory.txt\",\n",
        "                \"\\n\".join(inventory) + \"\\n\",\n",
        "            )\n",
        "\n",
        "            print(f\"Runtime: {elapsed:.2f} minutes\")\n",
        "            print(\"Files captured:\", len(files_found))\n",
        "            print(\"Status:\", status)\n",
        "\n",
        "            # Surface potential AxiECAMB transfer/switch warnings.\n",
        "            warning_lines = [\n",
        "                line for line in log_text.splitlines()\n",
        "                if (\n",
        "                    \"warning\" in line.lower()\n",
        "                    or \"before the switch\" in line.lower()\n",
        "                    or \"before switch\" in line.lower()\n",
        "                    or \"error\" in line.lower()\n",
        "                )\n",
        "            ]\n",
        "\n",
        "            save_text(\n",
        "                run_dir / \"warnings_and_errors.txt\",\n",
        "                (\n",
        "                    \"\\n\".join(warning_lines) + \"\\n\"\n",
        "                    if warning_lines\n",
        "                    else \"No warning/error keyword lines detected.\\n\"\n",
        "                ),\n",
        "            )\n",
        "\n",
        "            if warning_lines:\n",
        "                print(\"\\nInspect these solver warnings:\")\n",
        "                for line in warning_lines[-12:]:\n",
        "                    print(\" \", line)\n",
        "\n",
        "        except Exception as exc:\n",
        "            status = f\"FAILED: {type(exc).__name__}: {exc}\"\n",
        "            STATUS[\"axi_models\"][tag] = status\n",
        "\n",
        "            print(\"\\nMODEL FAILED:\", tag)\n",
        "            print(status)\n",
        "\n",
        "            save_text(\n",
        "                run_dir / \"error_traceback.txt\",\n",
        "                traceback.format_exc(),\n",
        "            )\n",
        "\n",
        "            if solver_log.exists():\n",
        "                print(\"\\nFinal solver log section:\")\n",
        "                print(solver_log.read_text(errors=\"replace\")[-8000:])\n",
        "\n",
        "else:\n",
        "    print(\n",
        "        \"\\nAxiECAMB scalar runs were skipped because the build failed. \"\n",
        "        \"The build log will be included in the final ZIP.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------- STEP 7: REPORT -------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 72)\n",
        "print(\"STEP 7 — Writing combined report\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "report = [\n",
        "    \"LR-DC / AxiECAMB COSMOLOGY PRELIMINARY TEST\",\n",
        "    \"=\" * 54,\n",
        "    \"\",\n",
        "    f\"AxiECAMB source commit: {STATUS['source_commit']}\",\n",
        "    \"\",\n",
        "    \"Shared target cosmology:\",\n",
        "    f\"  H0 = {H0} km/s/Mpc\",\n",
        "    f\"  omega_b h^2 = {OMBH2}\",\n",
        "    f\"  target total DM omega h^2 = {OMDMH2}\",\n",
        "    f\"  scalar amplitude As = {AS}\",\n",
        "    f\"  scalar tilt ns = {NS}\",\n",
        "    f\"  requested transfer redshifts = {REDSHIFTS}\",\n",
        "    \"\",\n",
        "    \"Statuses:\",\n",
        "    f\"  Standard CAMB Lambda-CDM control: {STATUS['camb_control']}\",\n",
        "    f\"  AxiECAMB build: {STATUS['axi_build']}\",\n",
        "]\n",
        "\n",
        "for tag, status in STATUS[\"axi_models\"].items():\n",
        "    report.append(f\"  {tag}: {status}\")\n",
        "\n",
        "report += [\n",
        "    \"\",\n",
        "    \"Interpretation limits:\",\n",
        "    \"1. Standard CAMB is the independent Lambda-CDM control. It is\",\n",
        "    \"   not the same code version or a bit-for-bit identical run to\",\n",
        "    \"   AxiECAMB, so precision comparisons require harmonized settings.\",\n",
        "    \"\",\n",
        "    \"2. The three masses are exploratory trial points, not measured\",\n",
        "    \"   or selected LR-DC parameters.\",\n",
        "    \"\",\n",
        "    \"3. AxiECAMB implements a quadratic-potential ultralight scalar\",\n",
        "    \"   model. Equivalence to the LR-DC complex KG branch has not been\",\n",
        "    \"   demonstrated, nor has derivation from the frozen Theory 2.5 action.\",\n",
        "    \"\",\n",
        "    \"4. The transfer files must be inspected for their actual columns,\",\n",
        "    \"   units, gauge conventions and switching-regime warnings. Do not\",\n",
        "    \"   assume they export signed KG field and field-derivative/current\",\n",
        "    \"   transfer functions suitable for constructing a wavefunction.\",\n",
        "    \"\",\n",
        "    \"5. This test does not close physical mode occupation, cosmological\",\n",
        "    \"   halo formation, stable rotating equilibrium, SPARC-175 blind\",\n",
        "    \"   predictions, lensing/mergers, or Planck/BAO/growth/S8 likelihoods.\",\n",
        "    \"\",\n",
        "    \"6. Theory 2.5 remains unchanged by this test.\",\n",
        "    \"\",\n",
        "]\n",
        "\n",
        "save_text(RESULTS / \"RUN_REPORT.txt\", \"\\n\".join(report) + \"\\n\")\n",
        "print(\"\\n\".join(report))\n",
        "\n",
        "\n",
        "# ------------------------- STEP 8: ZIP ALL OUTPUTS -------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 72)\n",
        "print(\"STEP 8 — Packaging logs and results\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "if ZIP_PATH.exists():\n",
        "    ZIP_PATH.unlink()\n",
        "\n",
        "with zipfile.ZipFile(\n",
        "    ZIP_PATH,\n",
        "    \"w\",\n",
        "    compression=zipfile.ZIP_DEFLATED,\n",
        ") as archive:\n",
        "    for path in ROOT.rglob(\"*\"):\n",
        "        if path.is_file():\n",
        "            archive.write(\n",
        "                path,\n",
        "                arcname=str(path.relative_to(ROOT.parent)),\n",
        "            )\n",
        "\n",
        "print(\"ZIP created:\", ZIP_PATH)\n",
        "print(\"ZIP size:\", f\"{ZIP_PATH.stat().st_size / 1e6:.2f} MB\")\n",
        "\n",
        "\n",
        "# ------------------------- STEP 9: DOWNLOAD -------------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 72)\n",
        "print(\"FINAL STATUS\")\n",
        "print(\"=\" * 72)\n",
        "\n",
        "print(\"Standard CAMB control:\", STATUS[\"camb_control\"])\n",
        "print(\"AxiECAMB build:\", STATUS[\"axi_build\"])\n",
        "\n",
        "for tag, status in STATUS[\"axi_models\"].items():\n",
        "    print(tag, \"=>\", status)\n",
        "\n",
        "print(\"\\nKeep all logs. A successful run is not, by itself, a scientific validation.\")\n",
        "\n",
        "try:\n",
        "    from google.colab import files\n",
        "    files.download(str(ZIP_PATH))\n",
        "except Exception as exc:\n",
        "    print(\"\\nAutomatic download did not start:\", exc)\n",
        "    print(\"Open Colab's Files panel and download:\")\n",
        "    print(str(ZIP_PATH))\n",
        "\n",
        "print(\"\\nFinished.\")"
      ]
    }
  ]
}