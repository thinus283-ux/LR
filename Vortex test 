        "\n",
        "# =============================================\n",
        "# Pure Topological Stress-Energy Contribution\n",
        "# Logic Relativity - Appendix H.1 Validation\n",
        "# =============================================\n",
        "\n",
        "!pip install numpy scipy matplotlib pandas -q\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from scipy.integrate import cumulative_trapezoid\n",
        "import pandas as pd\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# ================== THEORY PARAMETERS ==================\n",
        "alpha = 12.5          # Coupling from action\n",
        "kappa = 2.15          # Stiffness parameter\n",
        "G = 4.30091e-3        # pc/Msun (km/s)^2\n",
        "topo_norm = 45.0      # Scale from superfluid density (tuned)\n",
        "\n",
        "# ================== MOCK GALAXY DATA ==================\n",
        "np.random.seed(42)\n",
        "r = np.linspace(0.5, 50, 300)\n",
        "\n",
        "def generate_galaxy(name, v0, scale, outer_fall=0.72):\n",
        "    v_bary = v0 * (1 - np.exp(-r / scale)) * np.exp(-r * outer_fall / 50)\n",
        "    return pd.DataFrame({'radius': r, 'v_bary': v_bary, 'name': name})\n",
        "\n",
        "galaxies = [\n",
        "    generate_galaxy('HSB', 185, 3.8, 0.85),\n",
        "    generate_galaxy('LSB', 130, 9.2, 0.35),\n",
        "    generate_galaxy('Intermediate', 160, 6.0, 0.60)\n",
        "]\n",
        "\n",
        "# ================== PURE TOPOLOGICAL FUNCTIONS ==================\n",
        "def compute_vorticity_current(r, v_bary, alpha):\n",
        "    \"\"\"Kinematic vorticity 2-form proxy\"\"\"\n",
        "    omega = v_bary / r\n",
        "    domega_dr = np.gradient(omega, r, edge_order=2)\n",
        "    F_vort = np.abs(domega_dr)\n",
        "    J_vort = alpha * F_vort * (1 + kappa * np.exp(-r/18))\n",
        "    return F_vort, J_vort\n",
        "\n",
        "def topological_stress_density(r, J_vort, kappa, topo_norm):\n",
        "    \"\"\"rho_topo sourced purely by topological current divergence\"\"\"\n",
        "    div_J = np.gradient(J_vort, r, edge_order=2)\n",
        "    rho_topo = topo_norm * kappa * np.abs(div_J) * np.exp(-r/32) / (1 + r/25)\n",
        "    return rho_topo\n",
        "\n",
        "def topo_stress_acceleration(r, rho_topo, G):\n",
        "    \"\"\"Contribution from T_μν^topology in weak-field limit\"\"\"\n",
        "    M_topo_enc = cumulative_trapezoid(4 * np.pi * r**2 * rho_topo, r, initial=0)\n",
        "    a_topo = G * M_topo_enc / (r**2 + 1e-8)\n",
        "    return a_topo\n",
        "\n",
        "# ================== RUN ANALYSIS ==================\n",
        "fig, axs = plt.subplots(1, 3, figsize=(18, 6))\n",
        "fig.suptitle('Pure Topological Stress-Energy Contribution to Rotation Curves', fontsize=16)\n",
        "\n",
        "results = []\n",
        "\n",
        "for i, gal in enumerate(galaxies):\n",
        "    r = gal['radius'].values\n",
        "    v_bary = gal['v_bary'].values\n",
        "    name = gal['name'].iloc[0]\n",
        "\n",
        "    F, J = compute_vorticity_current(r, v_bary, alpha)\n",
        "    rho_topo = topological_stress_density(r, J, kappa, topo_norm)\n",
        "    a_topo = topo_stress_acceleration(r, rho_topo, G)\n",
        "\n",
        "    a_bary = v_bary**2 / r\n",
        "    a_total = a_bary + a_topo                     # Pure topological contribution\n",
        "    v_total = np.sqrt(np.maximum(a_total * r, 1e-3))\n",
        "\n",
        "    rms = np.sqrt(np.mean((v_total - v_bary)**2))\n",
        "    results.append({'Galaxy': name, 'RMS': round(rms, 3)})\n",
        "\n",
        "    axs[i].plot(r, v_bary, '--', label='Baryonic only', lw=2.5)\n",
        "    axs[i].plot(r, v_total, '-', label='+ Topological Stress-Energy', lw=3)\n",
        "    axs[i].set(xlabel='Radius [kpc]', ylabel='Velocity [km/s]',\n",
        "               title=f'{name} (RMS: {rms:.2f} km/s)')\n",
        "    axs[i].legend()\n",
        "    axs[i].grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "df = pd.DataFrame(results)\n",
        "print(\"\\n📊 RESULTS SUMMARY\")\n",
        "print(df)\n",
        "\n",
        "# ================== SCREENING ==================\n",
        "X = np.linspace(0.01, 0.99, 150)\n",
        "alpha_eff = np.where(X < 0.92, alpha / np.sqrt(np.maximum(1 - X, 1e-8)), 1e-6)\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "plt.plot(X, alpha_eff, lw=3)\n",
        "plt.title('Natural Screening from K-essence Non-Linearity')\n",
        "plt.xlabel('Kinetic Term X')\n",
        "plt.ylabel(r'\\( \\alpha_{\\rm eff} \\)')\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# ================== DIAGNOSTICS ==================\n",
        "F, J = compute_vorticity_current(r, galaxies[0]['v_bary'].values, alpha)\n",
        "rho_topo = topological_stress_density(r, J, kappa, topo_norm)\n",
        "print(f\"\\n✅ Diagnostics (HSB galaxy):\")\n",
        "print(f\"   |dF| mean        = {np.mean(np.abs(np.gradient(F, r))):.2e}\")\n",
        "print(f\"   Current div mean = {np.mean(np.abs(np.gradient(J, r))):.2e}\")\n",
        "print(f\"   Peak rho_topo    = {np.max(rho_topo):.4f}\")"
      ]
    }
