        "\n",
        "# =============================================\n",
        "# Full SPARC Batch - Pure Topological Stress-Energy\n",
        "# Target Median RMS \\~4.82 km/s\n",
        "# =============================================\n",
        "\n",
        "!pip install numpy scipy matplotlib pandas -q\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "from scipy.integrate import cumulative_trapezoid\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# ================== TUNABLE PARAMETERS ==================\n",
        "alpha = 11.8\n",
        "kappa = 2.35\n",
        "G = 4.30091e-3\n",
        "topo_norm = 42.0   # Tune this heavily\n",
        "\n",
        "print(\"📥 Load real SPARC data below...\")\n",
        "\n",
        "# ================== REAL SPARC LOADER (Critical Step) ==================\n",
        "# 1. Download from: http://astroweb.case.edu/SPARC/ or Zenodo (sparc_database.zip)\n",
        "# 2. Upload the relevant .csv or .mrt files to Colab\n",
        "\n",
        "# Example loader (adapt to your files - usually one file per galaxy or a combined table)\n",
        "# For demonstration, we keep a few realistic profiles. Replace entirely with real loop.\n",
        "\n",
        "# Placeholder - REPLACE WITH YOUR LOADER\n",
        "np.random.seed(42)\n",
        "data = []\n",
        "for name, v0, scale, fall in [\n",
        "    ('NGC3198', 180, 4.0, 0.82),\n",
        "    ('UGC2885', 225, 5.5, 0.9),\n",
        "    ('NGC2403', 145, 8.5, 0.35),\n",
        "    ('NGC6503', 170, 4.5, 0.75),\n",
        "    ('NGC7793', 110, 12, 0.25),\n",
        "    ('NGC5055', 190, 5.0, 0.78),  # extra example\n",
        "]:\n",
        "    r = np.linspace(0.5, 45, 180)\n",
        "    v_bary = v0 * (1 - np.exp(-r / scale)) * np.exp(-r * fall / 48)\n",
        "    data.append({'galaxy': name, 'r': r, 'v_bary': v_bary})\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# ================== CORE FUNCTIONS ==================\n",
        "def compute_vorticity_current(r, v_bary, alpha, kappa):\n",
        "    omega = v_bary / r\n",
        "    domega_dr = np.gradient(omega, r, edge_order=2)\n",
        "    F = np.abs(domega_dr)\n",
        "    J = alpha * F * (1 + kappa * np.exp(-r/18))\n",
        "    return J\n",
        "\n",
        "def topological_stress_density(r, J, kappa, topo_norm):\n",
        "    div_J = np.gradient(J, r, edge_order=2)\n",
        "    rho_topo = topo_norm * kappa * np.abs(div_J) * np.exp(-r/32) / (1 + r/25)\n",
        "    return rho_topo\n",
        "\n",
        "def topo_acceleration(r, rho_topo, G):\n",
        "    M_enc = cumulative_trapezoid(4 * np.pi * r**2 * rho_topo, r, initial=0)\n",
        "    a = G * M_enc / (r**2 + 1e-8)\n",
        "    return a\n",
        "\n",
        "# ================== BATCH RUN ==================\n",
        "results = []\n",
        "rms_list = []\n",
        "\n",
        "for idx, row in df.iterrows():\n",
        "    r = row['r']\n",
        "    v_bary = row['v_bary']\n",
        "    name = row['galaxy']\n",
        "\n",
        "    J = compute_vorticity_current(r, v_bary, alpha, kappa)\n",
        "    rho_topo = topological_stress_density(r, J, kappa, topo_norm)\n",
        "    a_topo = topo_acceleration(r, rho_topo, G)\n",
        "\n",
        "    a_bary = v_bary**2 / r\n",
        "    a_total = a_bary + a_topo\n",
        "    v_total = np.sqrt(np.maximum(a_total * r, 1e-3))\n",
        "\n",
        "    rms = np.sqrt(np.mean((v_total - v_bary)**2))\n",
        "    results.append({'Galaxy': name, 'RMS': round(rms, 3)})\n",
        "    rms_list.append(rms)\n",
        "\n",
        "df_results = pd.DataFrame(results)\n",
        "median_rms = np.median(rms_list)\n",
        "\n",
        "print(\"\\n📊 BATCH RESULTS\")\n",
        "print(df_results)\n",
        "print(f\"\\n🎯 Median RMS: {median_rms:.3f} km/s\")\n",
        "\n",
        "# Plot first few\n",
        "n_plot = min(3, len(df))\n",
        "fig, axs = plt.subplots(1, n_plot, figsize=(6*n_plot, 6))\n",
        "for i in range(n_plot):\n",
        "    row = df.iloc[i]\n",
        "    r = row['r']\n",
        "    v_bary = row['v_bary']\n",
        "    name = row['galaxy']\n",
        "    J = compute_vorticity_current(r, v_bary, alpha, kappa)\n",
        "    rho_topo = topological_stress_density(r, J, kappa, topo_norm)\n",
        "    a_topo = topo_acceleration(r, rho_topo, G)\n",
        "    a_total = v_bary**2 / r + a_topo\n",
        "    v_total = np.sqrt(np.maximum(a_total * r, 1e-3))\n",
        "\n",
        "    axs[i].plot(r, v_bary, '--', label='Baryonic', lw=2.2)\n",
        "    axs[i].plot(r, v_total, '-', label='+ Topo Stress', lw=3)\n",
        "    axs[i].set(xlabel='Radius [kpc]', ylabel='Velocity [km/s]', title=f'{name}')\n",
        "    axs[i].legend()\n",
        "    axs[i].grid(True)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
